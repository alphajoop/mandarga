# Database
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.z5qzrib.mongodb.net/<database_name>?retryWrites=true&w=majority"

# JWT Configuration
JWT_SECRET="<your_jwt_secret>"
JWT_EXPIRATION="15m"

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000
REFRESH_TOKEN_EXPIRY_DAYS=30

# Email Verification
EMAIL_VERIFICATION_EXPIRY_HOURS=24
RESEND_API_KEY="<your_resend_api_key>"
EMAIL_FROM="noreply@yourdomain.com"
APP_URL="http://localhost:3000"

# AWS S3 / Supabase Storage
SUPABASE_S3_REGION="us-east-1"
SUPABASE_S3_ENDPOINT="https://your-project.supabase.co/storage/v1/s3"
SUPABASE_S3_ACCESS_KEY="<your_access_key>"
SUPABASE_S3_SECRET_KEY="<your_secret_key>"
SUPABASE_S3_BUCKET="documents"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# OTP Settings
OTP_EXPIRY_MINUTES=10

# Environment
NODE_ENV="development"
PORT=3002