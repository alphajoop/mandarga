{
  "extends": "//",
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off"
      }
    },
    "domains": {
      "next": "none",
      "react": "none"
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "assist": {
    "enabled": true
  }
}
